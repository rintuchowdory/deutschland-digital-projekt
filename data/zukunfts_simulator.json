  "formeln": {
    "desi_2030": "75.2 + (ki_investitionen * 0.2) + (glasfaser_ausbau * 0.3) + (bildungs_investitionen * 0.15) + (infrastruktur_investitionen * 0.1)",
    "ki_nutzung_2030": "41 + (ki_investitionen * 0.015 * 100) + (fachkraefte_zuwanderung * 0.000005 * 100) + (bildungs_investitionen * 0.005 * 100)",
    "wirtschaft_2030": "42500 + (ki_investitionen * 50) + (fachkraefte_zuwanderung * 0.2) + (infrastruktur_investitionen * 40) + (bildungs_investitionen * 30)",
    "arbeitslosigkeit_2030": "5.8 - (fachkraefte_zuwanderung * 0.000005 * 100) - (ki_investitionen * 0.001 * 100) - (bildungs_investitionen * 0.0005 * 100)",
    "lebensqualitaet_2030": "75 + (glasfaser_ausbau * 0.15) + (bildungs_investitionen * 0.05) + (infrastruktur_investitionen * 0.1) + (klimaschutz_investitionen * 0.2) + ((100 - arbeitslosigkeit_2030) * 0.1)",
    "co2_2030": "7.8 - (klimaschutz_investitionen * 0.2)"
  },
  
  "hinweise": [
    "Die Berechnungen basieren auf vereinfachten Modellen und linearen Annahmen.",
    "In der Realität sind die Zusammenhänge komplexer und nicht-linear.",
    "Externe Faktoren (z.B. globale Wirtschaftslage, politische Entscheidungen) werden nicht berücksichtigt.",
    "Die Werte dienen der Veranschaulichung und sind keine offiziellen Prognosen.",
    "Für präzise Prognosen sollten detaillierte ökonometrische Modelle verwendet werden."
  ]
}