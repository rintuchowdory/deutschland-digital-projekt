    "year": 2026,
    "projection_year": 2030,
    "sources": ["Statistisches Bundesamt", "Bundesministerium für Wirtschaft und Energie", "KI-Strategie Deutschland", "Digitalstrategie 2030"],
    "last_updated": "2026-06-15"
